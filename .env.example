# Copy this file to .env and fill in your own values.
# .env is gitignored, so your Roblox IDs and ntfy topic stay private.

# Tracked users, as "<robloxUserId>:<label>"
# The label is only used to identify the user in the notifications.
USERS=("1493909200:Alice" "370166777:Bob")

# ntfy.sh topic that receives the notifications.
# Use a long random string to keep your topic private.
TOPIC="my_ntfy_topic"

# Optional: polling timings in seconds (defaults shown).
# REQUEST_DELAY=3
# CYCLE_DELAY=35